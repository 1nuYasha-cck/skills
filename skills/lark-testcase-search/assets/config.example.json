{
  "config_version": "2.0",
  "libraries": [
    {
      "name": "示例标准库",
      "kind": "standard",
      "base_token": "example_base",
      "tables": {"catalog": "example_catalog", "cases": "example_cases", "batches": "example_batches"},
      "folders": {"root": "example_root", "originals": "example_originals", "bodies": "example_bodies"}
    },
    {
      "name": "示例正式索引库",
      "kind": "standard",
      "schema_profile": "indexed",
      "base_token": "example_search_base",
      "url": "https://example.feishu.cn/base/example_search_base",
      "tables": {"cases": "example_index_cases", "catalog": "example_index_catalog", "batches": "example_batches", "sources": "example_sources", "review": "example_review"},
      "table_base_tokens": {"batches": "example_maintenance_base", "sources": "example_maintenance_base", "review": "example_maintenance_base"},
      "field_maps": {"cases": {"原用例编号": "原用例编号"}},
      "search_policy": {"default_scope": "published", "publication_field": "发布状态", "published_values": ["已发布"]}
    },
    {
      "name": "示例外部库",
      "kind": "external",
      "base_token": "example_external_base",
      "tables": {"cases": "example_external_cases"},
      "notes": "由 Agent 阅读字段表理解"
    }
  ],
  "doc_scopes": [{"name": "示例文档目录", "folder_token": "example_folder"}]
}
